---
import Nav from '@/components/Nav.astro';
import Card from '@/components/ui/Card.astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<BlogLayout title="Jean Carlo Hilger">
    <section class="section-container flex items-center p-4">
        <Nav disableReveal />

        <ul class="mt-20 flex flex-col gap-4 w-full md:w-2xl lg:w-4xl mx-auto">
            {posts.map(post =>(
                <li class="flex-1">
                    <Card
                        to=`/${post.collection}/${post.id}`
                        title={post.data.title}
                        content={post.data.description}
                        subtitle={post.data.date}
                        class="hover:bg-darker/20"
                    ></Card>
                </li>
            ))}
        </ul>
    </section>
</BlogLayout>
