---
interface Props {
    href: string;
    variant: 'primary' | 'secondary';
    outline?: boolean;
    class?: string;
    style?: string;
};

const {
    href,
    variant,
    outline,
    class: className,
    ...rest
} = Astro.props;

const variantStyle = {
    'primary': 'bg-primary rounded border-glow border border-primary cursor-pointer px-4 py-1 hover:brightness-80 transition text-decoration-none',
    'secondary': ''
}[variant];
---

<a href={href} class=`flex items-center ${variantStyle} ${outline && 'bg-transparent'} ${className}` {...rest}>
    <slot></slot>
</a>
