---

<nav
    id="nav"
    class="bg-background/50 backdrop-blur-md fixed top-0 left-0 right-0 -translate-y-full transition-transform duration-300 ease-out"
>
    <div class="flex flex-wrap items-center justify-between px-2 sm:px-12 md:px-14 lg:px-28 max-w-360 py-3">
        <span></span>
        <div class="flex gap-3">
            <a href="#career" class="p-1 hover:text-accent transition">Career</a>
            <a href="#blog" class="p-1">Blog</a>
            <a href="#contact" class="p-1">Contact</a>
        </div>
    </div>
</nav>

<script>
    window.addEventListener("scroll", () => {
        const nav = document.getElementById("nav");

        if (window.scrollY > window.innerHeight * 0.8) {
            nav?.classList.remove("-translate-y-full");
        } else {
            nav?.classList.add("-translate-y-full");
        }
    });
</script>
