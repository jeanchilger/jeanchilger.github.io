---

import { icons } from '@/lib/icons';
import { getCollection } from 'astro:content';

const contactData = await getCollection('contact');
---

<section id="contact" class="flex flex-col justify-center section-container">
    <div class="my-20 h-px bg-linear-to-r from-transparent via-gray-600/50 to-transparent"></div>

    <div class="mb-10 text-center">
        <h1 class="text-5xl">
            Let's connect
        </h1>
        <span class="text-md text-subtext scroll-stat" style="animation-delay: 200ms;">
            Interested in working together, consulting, or discussing a project? Get in touch!
        </span>
    </div>

    <div class="flex items-center justify-center gap-3">
        {contactData.map(contact => {
            const Icon = icons[contact.data.icon];

            return (
                <a
                    href={contact.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card hover:border-glow outlined cursor-pointer flex flex-row items-center text-blue border-blue text-lg no-underline"
                >
                    <Icon class="w-8 fill-blue" /> {contact.data.label}
                </a>
        )})}
    </div>

    <div class="my-20 h-px bg-linear-to-r from-transparent via-gray-600/50 to-transparent"></div>
</section>
