---
import { icons } from '@/lib/icons';
import { getCollection } from 'astro:content';

const contactData = await getCollection('contact');
---

<section id="contact" class="flex flex-col justify-center section-container max-sm:px-0">
    <div class="my-20 h-px bg-linear-to-r from-transparent via-gray-600/50 to-transparent"></div>

    <div class="mb-10 text-center max-sm:px-8">
        <h1 class="text-5xl">
            Let's connect
        </h1>
        <span class="text-md text-subtext scroll-stat" style="animation-delay: 200ms;">
            Interested in working together, consulting, or discussing a project? Get in touch!
        </span>
    </div>

    <div class="flex max-sm:flex-col items-center justify-center gap-2 md:gap-3">
        {contactData.map(contact => {
            const Icon = icons[contact.data.icon];

            return (
                <a
                    href={contact.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card outlined contact-card max-sm:gap-4 max-md:gap-2"
                >
                    <Icon class="max-sm:w-6 max-md:w-4 md:w-6 lg:w-8 fill-primary" />
                    <span class="max-sm:text-lg max-md:text-sm md:text-base lg:text-lg">
                        {contact.data.label}
                    </span>
                </a>
        )})}
    </div>

    <div class="my-20 h-px bg-linear-to-r from-transparent via-gray-600/50 to-transparent"></div>
</section>
