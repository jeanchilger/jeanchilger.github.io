---
import Banner from './Banner.astro';

interface Props {
    title: string;
    description?: string;
    date?: string;
    updatedDate?: string;
    readingTime?: string;
    tags?: string[];
    banner?: string;
    bannerAlt?: string;
}

const {
    title,
    description,
    date,
    updatedDate,
    readingTime,
    tags = [],
    banner,
    bannerAlt = '',
} = Astro.props;
---

<section class="blog-header-section mb-20">
    <div class="blog-header-background">
        {banner && (<Banner banner={banner} alt={bannerAlt} />)}
        <div class="blog-header-overlay"></div>
    </div>

    <div class="section-container relative z-10">
        <div class="max-w-3xl">
            <div class="mb-6 text-sm uppercase tracking-[0.3em] text-subtext">
                Blog post
            </div>

            <h1 class="text-4xl font-heading font-semibold tracking-tight leading-tight text-maintext sm:text-5xl md:text-6xl">
                {title}
            </h1>

            {description && (
                <p class="mt-5 max-w-2xl text-base leading-8 text-subtext sm:text-lg">
                    {description}
                </p>
            )}

            <div class="mt-6 flex flex-col gap-3 text-sm text-subtext sm:flex-row sm:items-center sm:flex-wrap">
                {date && <span>{date}</span>}
                {updatedDate && <span>Updated {updatedDate}</span>}
                {readingTime && <span>{readingTime}</span>}
            </div>

            {tags.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                    {tags.map(tag => (
                        <span class="badge badge-primary">#{tag}</span>
                    ))}
                </div>
            )}
        </div>
    </div>
</section>
