---
import { Image } from 'astro:assets';

type BannerSource = string | Record<string, any>;

interface Props {
    banner?: BannerSource;
    alt?: string;
}

const { banner, alt = '' } = Astro.props;
const isMetadata = typeof banner === 'object' && banner !== null;

function resolveImagePath(name: string) {
    if (!name) {
        return name;
    }

    if (name.startsWith('http') || name.startsWith('/')) {
        return name;
    }

    return `/static/images/${name}`;
}
---

<div class="h-full w-full overflow-hidden">
    {banner && isMetadata ? (
        <Image
            src={banner as ImageMetadata}
            alt={alt}
            sizes="100vw"
            class="h-full w-full object-cover"
            loading="lazy"
        />
    ) : banner ? (
        <img
            src={resolveImagePath(banner)}
            alt={alt}
            class="h-full w-full object-cover"
            loading="lazy"
        />
    ) : null}
</div>
