---
import '../styles/global.css';
import Head from '@/components/Head.astro';

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    image?: string;
}

const { title, description, canonical, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <Head title={title} description={description} canonical={canonical} image={image} />
    </head>

    <body class="relative min-h-screen overflow-x-hidden antialiased bg-dark">
        <slot></slot>
    </body>
</html>
